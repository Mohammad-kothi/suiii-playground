{
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/search.js": { "maxDuration": 30 },
    "api/read.js": { "maxDuration": 30 },
    "api/models.js": { "maxDuration": 20 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
